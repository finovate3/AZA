generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                           String    @id @default(cuid())
  name                         String
  email                        String    @unique
  phone                        String?   @unique
  tag                          String    @unique
  passwordHash                 String?
  isVerified                   Boolean   @default(false)
  onboardingComplete           Boolean   @default(false)
  role                         String    @default("CUSTOMER")
  transactionPinHash           String?
  transactionPinSetAt          DateTime?
  transactionPinFailedAttempts Int       @default(0) @map("transactionPinFailedAttempts")
  transactionPinLockedUntil    DateTime?

  emailNotifications    Boolean @default(true)
  smsNotifications      Boolean @default(false)
  whatsappNotifications Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account           Account?
  verificationCodes VerificationCode[]
  sessions          Session[]
  notifications     Notification[]
}

model Account {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Decimal  @default(0) @db.Decimal(18, 2)
  currency  String   @default("NGN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                       User                        @relation(fields: [userId], references: [id])
  transactions               Transaction[]
  savings                    Savings?
  rainyDaySavings            RainyDaySavings[]
  lockedSavingsContributions LockedSavingsContribution[]
  card                       Card?
  beneficiaries              Beneficiary[]
}

model Transaction {
  id                              String                     @id @default(cuid())
  accountId                       String
  type                            String
  amount                          Decimal                    @db.Decimal(18, 2)
  currency                        String                     @default("NGN")
  status                          String                     @default("COMPLETED")
  transferInitiationClaimedAt     DateTime?
  riskLevel                       String                     @default("LOW")
  reviewStatus                    String                     @default("NOT_REQUIRED")
  description                     String?
  recipient                       String?
  recipientCode                   String?
  bankCode                        String?
  accountNumber                   String?
  createdAt                       DateTime                   @default(now())
  pinVerifiedAt                   DateTime?
  pinChallengeExpiresAt           DateTime?
  lockedSavingsContribution       Decimal                    @default(0) @db.Decimal(18, 2)
  reference                       String                     @unique
  account                         Account                    @relation(fields: [accountId], references: [id])
  lockedSavingsContributionRecord LockedSavingsContribution?

  @@index([accountId])
  @@index([createdAt])
}

model VerificationCode {
  id        String   @id @default(cuid())
  userId    String
  codeHash  String
  type      String
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Savings {
  id             String   @id @default(cuid())
  accountId      String   @unique
  amount         Decimal  @db.Decimal(18, 2)
  targetAmount   Decimal  @db.Decimal(18, 2)
  interestRate   Decimal  @db.Decimal(5, 2)
  lockPeriodDays Int      @default(300)
  startDate      DateTime
  maturityDate   DateTime
  status         String   @default("ACTIVE")
  reference      String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id])

  @@index([maturityDate])
  @@index([status])
}

model LockedSavingsContribution {
  id            String    @id @default(cuid())
  accountId     String
  transactionId String    @unique
  amount        Decimal   @db.Decimal(18, 2)
  startDate     DateTime  @default(now())
  maturityDate  DateTime
  status        String    @default("LOCKED")
  reference     String    @unique
  reversedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  account     Account     @relation(fields: [accountId], references: [id])
  transaction Transaction @relation(fields: [transactionId], references: [id])

  @@index([accountId])
  @@index([maturityDate])
  @@index([status])
}

model RainyDaySavings {
  id        String   @id @default(cuid())
  accountId String
  amount    Decimal  @db.Decimal(18, 2)
  reference String   @unique
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([createdAt])
  @@index([status])
}

model Card {
  id             String   @id @default(cuid())
  accountId      String   @unique
  cardNumber     String   @unique
  expiryMonth    Int
  expiryYear     Int
  cvv            String
  cardholderName String
  type           String   @default("VIRTUAL")
  status         String   @default("ACTIVE")
  spendingLimit  Decimal  @default(500000) @db.Decimal(18, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id])
}

model Notification {
  id          String    @id @default(cuid())
  userId      String
  channel     String
  type        String
  title       String
  message     String
  status      String    @default("PENDING")
  scheduledAt DateTime
  sentAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([scheduledAt])
  @@index([status])
}

model Beneficiary {
  id        String @id @default(cuid())
  accountId String

  accountNumber String
  bankCode      String
  bankName      String?
  accountName   String
  recipientCode String?
  currency      String  @default("NGN")

  verifiedAt DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, bankCode, accountNumber])
  @@index([accountId])
  @@index([recipientCode])
}
